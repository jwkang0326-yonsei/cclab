opt_out_usage

default_platform(:android)

# service-account.json의 절대 경로 계산 (fastlane/ 디렉토리 기준)
SERVICE_ACCOUNT_PATH = File.expand_path("service-account.json", __dir__)

platform :android do
  desc "Submit a new Internal Build to Google Play"
  lane :internal do
    # Ensure the git status is clean, except in CI
    ensure_git_status_clean unless is_ci

    # 시크릿 파일 경로 확인 및 로그 출력
    UI.message("🔍 Checking for service-account.json at: #{SERVICE_ACCOUNT_PATH}")
    if File.exist?(SERVICE_ACCOUNT_PATH)
      UI.message("✅ service-account.json found.")
    else
      UI.error("❌ ERROR: service-account.json not found!")
      UI.message("💡 GitHub Actions workflow should create this file at 'app/android/fastlane/service-account.json'")
      UI.user_error!("Please ensure the service-account.json file exists.")
    end

    # AAB 파일 경로 탐색 (플러터 루트 build 폴더 기준)
    # 1. ../../build/ (정석)
    # 2. ../build/ (혹시나 android/build에 생성될 경우)
    possible_aab_paths = [
      File.expand_path('../../build/app/outputs/bundle/release/app-release.aab', __dir__),
      File.expand_path('../build/app/outputs/bundle/release/app-release.aab', __dir__)
    ]
    
    UI.message("📦 Searching for AAB file in:")
    possible_aab_paths.each { |path| UI.message("   - #{path} (Exists: #{File.exist?(path)})") }

    aab_path = possible_aab_paths.find { |path| File.exist?(path) }

    if aab_path
      UI.message("✅ AAB file found. Starting upload...")
    else
      UI.error("❌ ERROR: AAB file not found!")
      UI.message("💡 Expected path: #{possible_aab_paths.first}")
      UI.user_error!("Build failed or path mismatch. Please check your flutter build command.")
    end

    # Upload the AAB to Play Store
    upload_to_play_store(
      track: 'internal',
      aab: aab_path,
      json_key: SERVICE_ACCOUNT_PATH
    )
  end

  desc "Distribute a new build to Firebase App Distribution"
  lane :firebase_dist do |options|
    firebase_app_distribution(
      app: "1:983598640244:android:60548d0ada68f95c9bb521",
      apk_path: "../build/app/outputs/flutter-apk/app-release.apk",
      service_credentials_file: SERVICE_ACCOUNT_PATH,
      groups: "testers",
      release_notes: options[:notes] || "Manual build"
    )
  end
end
