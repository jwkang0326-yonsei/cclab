opt_out_usage

default_platform(:android)

# service-account.json의 절대 경로 계산 (fastlane/ 디렉토리 기준)
SERVICE_ACCOUNT_PATH = File.expand_path("service-account.json", __dir__)

platform :android do
  desc "Submit a new Internal Build to Google Play"
  lane :internal do
    # Ensure the git status is clean, except in CI
    ensure_git_status_clean unless is_ci

    UI.message("📄 Service account path: #{SERVICE_ACCOUNT_PATH}")
    UI.message("📄 File exists: #{File.exist?(SERVICE_ACCOUNT_PATH)}")

    # Upload the AAB to Play Store
    upload_to_play_store(
      track: 'internal',
      aab: '../build/app/outputs/bundle/release/app-release.aab',
      json_key: SERVICE_ACCOUNT_PATH
    )
  end

  desc "Distribute a new build to Firebase App Distribution"
  lane :firebase_dist do |options|
    firebase_app_distribution(
      app: "1:983598640244:android:60548d0ada68f95c9bb521",
      apk_path: "../build/app/outputs/flutter-apk/app-release.apk",
      service_credentials_file: SERVICE_ACCOUNT_PATH,
      groups: "testers",
      release_notes: options[:notes] || "Manual build"
    )
  end
end
