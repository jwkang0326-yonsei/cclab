opt_out_usage

default_platform(:ios)

platform :ios do
  before_all do
    # App Store Connect API Key setup
    # fastlane/ 디렉토리 기준으로 절대 경로 탐색
    fastlane_dir = File.expand_path(__dir__)             # ios/fastlane/ 디렉토리
    ios_dir = File.expand_path("..", fastlane_dir)       # ios/ 디렉토리

    UI.message("🔍 Searching for api_key.p8 in:")
    possible_paths = [
      File.join(fastlane_dir, "api_key.p8"),  # ios/fastlane/api_key.p8
      File.join(ios_dir, "api_key.p8"),        # ios/api_key.p8
    ]
    possible_paths.each { |path| UI.message("   - #{path} (Exists: #{File.exist?(path)})") }
    
    api_key_path = possible_paths.find { |path| File.exist?(path) }
    
    if api_key_path
      UI.message("✅ Using API Key file at: #{api_key_path}")
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key_filepath: api_key_path
      )
    else
      UI.error("❌ ERROR: api_key.p8 file not found!")
      UI.message("💡 GitHub Actions workflow should create this file at 'app/ios/fastlane/api_key.p8'")
      UI.user_error!("Please ensure the api_key.p8 file is created before running fastlane.")
    end
  end

  desc "Push a new beta build to TestFlight"
  lane :beta do
    ensure_git_status_clean unless is_ci
    
    # CI 환경에서 별도 키체인 생성 (키체인 비밀번호 팝업 방지)
    if is_ci
      keychain_name = "fastlane_tmp_keychain"
      keychain_password = "fastlane_tmp_password"
      
      create_keychain(
        name: keychain_name,
        password: keychain_password,
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false
      )
      
      # Sync certificates (CI: 임시 키체인 사용)
      match(
        type: "appstore",
        readonly: true,
        keychain_name: keychain_name,
        keychain_password: keychain_password
      )
    else
      # 로컬: 기존 방식
      match(type: "appstore", readonly: false)
    end

    # 프로젝트 서명 설정 업데이트 (최신 방식)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      bundle_identifier: "org.cclab.withbible",
      profile_name: ENV["sigh_org.cclab.withbible_appstore_profile-name"],
      code_sign_identity: "Apple Distribution",
      build_configurations: "Release"
    )

    # Build the application
    build_app(
      workspace: "Runner.xcworkspace", 
      scheme: "Runner",
      export_method: "app-store",
      codesigning_identity: "Apple Distribution", # 명시적으로 한 번 더 지정
      export_options: {
        provisioningProfiles: {
          "org.cclab.withbible" => ENV["sigh_org.cclab.withbible_appstore_profile-name"]
        }
      },
      silent: true
    )

    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Distribute a new build to Firebase App Distribution"
  lane :firebase_dist do |options|
    # Sync adhoc certificates for Firebase
    match(type: "adhoc", readonly: ENV["CI"])

    # Build the application for adhoc distribution
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "ad-hoc"
    )

    # Upload to Firebase
    firebase_app_distribution(
      app: "1:983598640244:ios:38a0ead3b4ba7fb59bb521",
      groups: "testers",
      release_notes: options[:notes] || "Manual iOS build"
    )
  end
end
