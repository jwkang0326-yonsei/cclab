opt_out_usage

default_platform(:ios)

platform :ios do
  before_all do
    # 변수 설정만 진행
    @key_id = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
    @issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
    @key_content = ENV["APP_STORE_CONNECT_API_KEY_KEY"]
  end

  desc "Push a new beta build to TestFlight"
  lane :beta do
    ensure_git_status_clean unless is_ci
    
    # API Key 설정 (match용)
    api_key = app_store_connect_api_key(
      key_id: @key_id,
      issuer_id: @issuer_id,
      key_content: @key_content,
      in_house: false
    )

    # CI 환경에서 별도 키체인 생성
    if is_ci
      keychain_name = "fastlane_tmp_keychain"
      keychain_password = "fastlane_tmp_password"
      create_keychain(
        name: keychain_name,
        password: keychain_password,
        default_keychain: true,
        unlock: true,
        timeout: 3600
      )
      match(type: "appstore", readonly: true, keychain_name: keychain_name, keychain_password: keychain_password)
    else
      match(type: "appstore", readonly: false)
    end

    # 프로젝트 서명 설정 업데이트
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      bundle_identifier: "org.cclab.withbible",
      profile_name: ENV["sigh_org.cclab.withbible_appstore_profile-name"],
      code_sign_identity: "Apple Distribution",
      build_configurations: "Release"
    )

    # Build the application
    build_app(
      workspace: "Runner.xcworkspace", 
      scheme: "Runner",
      export_method: "app-store",
      codesigning_identity: "Apple Distribution",
      export_options: {
        provisioningProfiles: {
          "org.cclab.withbible" => ENV["sigh_org.cclab.withbible_appstore_profile-name"]
        }
      },
      silent: true
    )

    # 빌드 완료 후 Apple 서버와 세션 동기화를 위해 잠시 대기
    UI.message("☕️ Taking a 10-second break for session sync...")
    sleep(10)

    # 인증 정보 디버깅 (보안을 위해 길지만 출력)
    UI.message("🔍 Debugging Auth Info:")
    UI.message("   - Key ID Length: #{@key_id.to_s.strip.length}")
    UI.message("   - Issuer ID Length: #{@issuer_id.to_s.strip.length}")
    
    # Upload to TestFlight using Pilot (Fastlane에서 가장 강력한 업로드 도구)
    # api_key를 직접 생성하여 주입하는 가장 확실한 방식입니다.
    begin
      UI.message("🚀 Attempting upload via Pilot...")
      pilot(
        api_key: app_store_connect_api_key(
          key_id: @key_id.to_s.strip,
          issuer_id: @issuer_id.to_s.strip,
          key_content: @key_content,
          duration: 1200
        ),
        ipa: ENV["IPA_OUTPUT_PATH"] || "Runner.ipa",
        skip_waiting_for_build_processing: true,
        skip_submission: true # 심사 제출은 관리자가 직접
      )
      UI.success("🎉 Successfully uploaded to TestFlight!")
    rescue => e
      UI.error("❌ Upload failed with error: #{e.message}")
      UI.message("💡 Tip: Please check if the API Key has 'App Manager' or 'Admin' role.")
      UI.message("💡 Tip: Check for any pending Agreements in App Store Connect.")
      raise e
    end
  end

  desc "Distribute a new build to Firebase App Distribution"
  lane :firebase_dist do |options|
    # Sync adhoc certificates for Firebase
    match(type: "adhoc", readonly: ENV["CI"])

    # Build the application for adhoc distribution
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "ad-hoc"
    )

    # Upload to Firebase
    firebase_app_distribution(
      app: "1:983598640244:ios:38a0ead3b4ba7fb59bb521",
      groups: "testers",
      release_notes: options[:notes] || "Manual iOS build"
    )
  end
end
